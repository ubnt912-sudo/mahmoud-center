# رابط قاعدة PostgreSQL (Neon / Supabase / أي خادم PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mahmoud_center?schema=public"

# مفتاح سري طويل وعشوائي لتوقيع جلسات الدخول (32 حرفاً على الأقل)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# رابط الموقع بعد النشر (يُستخدم في روابط بوابة الزبون وواتساب)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
